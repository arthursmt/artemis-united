# Observabilidade (Sentry + Better Stack, decisão #12) — sem projeto Sentry criado
# por esta sessão; deixar vazio no dev local é seguro, Sentry.init() faz no-op.
SENTRY_DSN=

# Auth interna api -> bob-engine (decisão #8, docs/architecture.md §1.4). Precisa do
# MESMO valor em apps/api/.env. Vazio aqui = middleware rejeita tudo com 500 (falha
# fechada) — defina um valor real no .env local antes de rodar o serviço.
INTERNAL_SECRET=
