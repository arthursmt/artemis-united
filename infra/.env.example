POSTGRES_USER=artemis
POSTGRES_PASSWORD=artemis
POSTGRES_DB=artemis_united
POSTGRES_PORT=5432

# Metabase (local docker-compose container, connects to remote Neon staging/prod —
# never to the local postgres service above). Role created by
# services/bob-engine/drizzle/manual/0001_metabase_readonly_role.sql — apply that
# script by hand against the target Neon branch first, then fill these in.
METABASE_DB_HOST=
METABASE_DB_NAME=
METABASE_DB_PASSWORD=
