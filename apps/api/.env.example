DATABASE_URL=postgresql://artemis:artemis@localhost:5432/artemis_united
PORT=4000
NODE_ENV=development

# Auth interna api -> bob-engine (decisão #8, docs/architecture.md §1.4). Precisa do
# MESMO valor em services/bob-engine/.env.
BOB_ENGINE_URL=http://localhost:4100
INTERNAL_SECRET=

# Base do frontend, usada para montar links de email (verificação de conta,
# reset de senha, 2FA).
WEB_APP_URL=http://localhost:5173

# Resend é o provedor de PRODUÇÃO (decisão fechada, ver Log de decisões do
# plano mestre) — lib/email/. Sem a chave (padrão em dev local), o app cai
# para Ethereal Email automaticamente (conta de teste criada por API, sem
# variável de ambiente própria) — nenhum ambiente sem RESEND_API_KEY fica
# sem conseguir enviar/inspecionar email.
RESEND_API_KEY=
# Opcional — remetente usado só quando RESEND_API_KEY está setada. Sem essa
# var, usa um endereço de teste do próprio Resend (onboarding@resend.dev),
# que só funciona pra enviar pro email cadastrado na conta Resend — configurar
# aqui com um domínio verificado antes de qualquer envio real a usuários.
RESEND_FROM_ADDRESS=

# Chat com BoB (Etapa 5, seção 4.6) — sem chave, POST /v1/chat responde
# {configured: false} explicitamente, nunca simula resposta nem trava. Mesmo
# padrão do SENTRY_DSN vazio.
ANTHROPIC_API_KEY=
