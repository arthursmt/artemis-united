DATABASE_URL=postgresql://artemis:artemis@localhost:5432/artemis_united
PORT=4000
NODE_ENV=development

# Auth interna api -> bob-engine (decisão #8, docs/architecture.md §1.4). Precisa do
# MESMO valor em services/bob-engine/.env.
BOB_ENGINE_URL=http://localhost:4100
INTERNAL_SECRET=

# Base do frontend, usada para montar links de email (verificação de conta,
# reset de senha). Emails são stub (services/apps/api/src/lib/emailStub.ts) —
# nenhum provedor real configurado ainda, o link só aparece no log.
WEB_APP_URL=http://localhost:5173

# Chat com BoB (Etapa 5, seção 4.6) — sem chave, POST /v1/chat responde
# {configured: false} explicitamente, nunca simula resposta nem trava. Mesmo
# padrão do SENTRY_DSN vazio.
ANTHROPIC_API_KEY=
